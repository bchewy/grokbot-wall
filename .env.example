# Copy this file to .env and fill it in. Restart serve.mjs after editing.

# Shown as the drifting headline on the wall and used in the email. Defaults to "Grok Bot Meetup".
EVENT_NAME=

# --- Luma ---  Luma → Settings → Developer → API Keys. Without a key the wall runs in demo mode.
LUMA_API_KEY=
# Pin the event (evt-...). Otherwise the nearest upcoming event on the calendar is picked.
LUMA_EVENT_ID=

# --- Resend (optional): emails each guest their code the moment they check in ---
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (Domains → Add). Without one, only
# onboarding@resend.dev works, and only to your own Resend account email.
EMAIL_FROM=Grok Bot <hello@yourdomain.com>
EMAIL_REPLY_TO=
EMAIL_SUBJECT=
EMAIL_EVENT_NAME=
# Rehearsal switches: EMAIL_DRY_RUN=1 logs instead of sending; EMAIL_TEST_TO=you@x.com
# redirects EVERY guest email to that address (subject shows the original recipient).
EMAIL_DRY_RUN=0
EMAIL_TEST_TO=
# EMAIL_OFF=1 disables sending entirely even if a key is present.
EMAIL_OFF=0

# --- hosting ---
PORT=8787
# Access token: everything except the Luma webhook and /assets requires it. Open the wall as /?key=<token>
WALL_TOKEN=
# Public base URL of this server (no trailing slash). When set, the server registers the Luma
# webhook (guest.updated) for <PUBLIC_URL>/webhooks/luma itself on startup.
PUBLIC_URL=
